# Backend production — référence uniquement, Render ne charge pas ce fichier.
# Saisir les valeurs dans Render. Ne jamais committer de secret ni d'URL de connexion.

# -------------------- Obligatoire / spécifique au déploiement --------------------
DJANGO_DEBUG=false
# Générer une valeur aléatoire longue dans Render.
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=api.votre-domaine.ci,ecarnet-api.onrender.com

# URL Neon fournie par le service PostgreSQL/Neon.
DATABASE_URL=

# -------------------- Cloudinary (uploads privés et visuels) --------------------
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_BASE_FOLDER=e-carnet

# Origine publique du frontend (également utilisée pour les callbacks OAuth).
# L'API est appelée via le proxy Next.js sur cette origine.
WEB_ORIGIN=https://app.votre-domaine.ci
CORS_ALLOWED_ORIGINS=https://app.votre-domaine.ci
CSRF_TRUSTED_ORIGINS=https://app.votre-domaine.ci

# -------------------- Security / cookies --------------------
# Render termine TLS. Ces valeurs ont des défauts sûrs en production.
DJANGO_SSL_REDIRECT=true
DJANGO_HSTS_SECONDS=86400
DRF_NUM_PROXIES=1
SESSION_COOKIE_SAMESITE=None
CSRF_COOKIE_SAMESITE=None
# Ne pas définir SESSION_COOKIE_DOMAIN ni CSRF_COOKIE_DOMAIN :
# via le proxy Next.js, les cookies restent host-only sur l'origine frontend app.
# DJANGO_ADMIN_PATH=un-chemin-non-evident/

# Bootstrap initial uniquement : retirer ces variables de Render après création du superadmin.
DJANGO_ADMIN_EMAIL=
DJANGO_ADMIN_PASSWORD=

# -------------------- Application options --------------------
ECARNET_SESSION_AGE_SECONDS=28800
ECARNET_QR_TTL_SECONDS=300
# Par défaut, l'URL d'invitation est dérivée de WEB_ORIGIN.
ECARNET_INVITATION_BASE_URL=https://app.votre-domaine.ci/etablissement/activation
# À renseigner seulement après validation juridique du seuil applicable.
# Vide/non défini = profils représentés et demandes de transfert désactivés.
# ECARNET_REPRESENTATION_LEGAL_AGE=

# -------------------- SMTP (requis pour les invitations et notifications e-mail) --------------------
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# Gmail / Google Workspace : utiliser SSL direct sur 465 (pas STARTTLS).
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=465
EMAIL_HOST_USER=
# Utiliser un mot de passe d'application Google, pas le mot de passe du compte.
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=false
EMAIL_USE_SSL=true
DEFAULT_FROM_EMAIL=
# Optionnel : destinataires du formulaire de contact, séparés par des virgules.
ECARNET_CONTACT_NOTIFY_TO=
# Limite par défaut du formulaire de contact : 5/hour.
# ECARNET_RATE_CONTACT=5/hour

# -------------------- OAuth (optionnel, backend uniquement) --------------------
# Configurer une paire seulement pour chaque fournisseur activé.
# Enregistrer le callback https://app.votre-domaine.ci/api/v1/identity/oauth/<fournisseur>/callback/
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
APPLE_CLIENT_ID=
APPLE_CLIENT_SECRET=
