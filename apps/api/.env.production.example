# Reference only. Render/Docker do not load this file automatically.
# Add these values in the Render dashboard or keep the Blueprint in sync.
# Never commit real secrets or connection strings.

DJANGO_DEBUG=false
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=ecarnet-api.onrender.com
DJANGO_LOG_LEVEL=INFO
DJANGO_SSL_REDIRECT=true
DJANGO_HSTS_SECONDS=86400
DRF_NUM_PROXIES=1

# Neon PostgreSQL connection string: enter the real value in Render only.
DATABASE_URL=

# Browser origins: no trailing slash.
WEB_ORIGIN=https://e-carnetci.vercel.app
CORS_ALLOWED_ORIGINS=https://e-carnetci.vercel.app
CSRF_TRUSTED_ORIGINS=https://e-carnetci.vercel.app
SESSION_COOKIE_SAMESITE=None
CSRF_COOKIE_SAMESITE=None
# Keep cookie domain variables empty (host-only API cookies).
SESSION_COOKIE_DOMAIN=
CSRF_COOKIE_DOMAIN=

ECARNET_SESSION_AGE_SECONDS=28800
ECARNET_QR_TTL_SECONDS=300
ECARNET_INVITATION_BASE_URL=https://e-carnetci.vercel.app/etablissement/activation

# Set real SMTP values in Render before enabling email invitations.
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
EMAIL_USE_SSL=false
DEFAULT_FROM_EMAIL=

# Optional OAuth. Add real provider credentials only in Render.
# These are server-side variables; never expose them as NEXT_PUBLIC_*.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
APPLE_CLIENT_ID=
APPLE_CLIENT_SECRET=
