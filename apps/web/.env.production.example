# Frontend production — référence uniquement, Vercel ne charge pas ce fichier.
# Définir dans Vercel puis redéployer : NEXT_PUBLIC_* est intégré au bundle.
# Ces valeurs sont publiques. Ne jamais y mettre de secret.
NEXT_PUBLIC_API_URL=https://api.votre-domaine.ci
NEXT_PUBLIC_SITE_URL=https://app.votre-domaine.ci
# Optionnel : adresse publique utilisée par les liens de contact.
# NEXT_PUBLIC_CONTACT_EMAIL=contact@votre-domaine.ci
