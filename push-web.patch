@@ -0,0 +1,61 @@
+"use client";
+
+import { useEffect, useState } from "react";
+import { currentPushSubscription, pushSupport, subscribeToPush, unsubscribeFromPush } from "../lib/push";
+
+type State = "loading" | "off" | "on" | "denied" | "unsupported" | "ios-install" | "unavailable" | "error";
+
+const MESSAGES: Partial<Record<State, string>> = {
+  denied: "Les notifications sont bloquées pour ce site. Autorisez-les dans les réglages de votre navigateur, puis réessayez.",
+  "ios-install": "Sur iPhone et iPad, ajoutez d’abord Mon E‑Carnet à l’écran d’accueil (Partager, puis « Sur l’écran d’accueil »), puis rouvrez l’application depuis cette icône pour activer les notifications.",
+  unsupported: "Ce navigateur ne permet pas les notifications. Vos rappels restent visibles dans l’application.",
+  unavailable: "Les notifications sur l’appareil ne sont pas encore disponibles. Vos rappels restent visibles dans l’application.",
+  error: "Activation impossible pour le moment. Réessayez dans un instant.",
+};
+
+export function PushNotificationToggle() {
+  const [state, setState] = useState<State>("loading");
+
+  useEffect(() => {
+    let active = true;
+    (async () => {
+      const support = pushSupport();
+      if (support !== "ok") return active && setState(support === "ios-install" ? "ios-install" : "unsupported");
+      if (Notification.permission === "denied") return active && setState("denied");
+      const subscription = await currentPushSubscription().catch(() => null);
+      if (active) setState(subscription && Notification.permission === "granted" ? "on" : "off");
+    })();
+    return () => { active = false; };
+  }, []);
+
+  async function toggle() {
+    if (state === "on") {
+      setState("loading");
+      await unsubscribeFromPush();
+      setState("off");
+      return;
+    }
+    setState("loading");
+    const result = await subscribeToPush(); // directement dans le clic : exigé par iOS
+    setState(result === "subscribed" ? "on" : result === "denied" ? "denied" : result === "unavailable" ? "unavailable" : "error");
+  }
+
+  const canToggle = state === "off" || state === "on" || state === "error" || state === "loading";
+  return (
+    <div className="settings-modal-section">
+      <span className="eyebrow">Sur cet appareil</span>
+      {canToggle && (
+        <div className="actions">
+          <button type="button" className={state === "on" ? "button ghost" : "button primary"} disabled={state === "loading"} aria-pressed={state === "on"} onClick={toggle}>
+            {state === "loading" ? "Un instant…" : state === "on" ? "Désactiver les notifications" : "Activer les notifications"}
+          </button>
+        </div>
+      )}
+      <p className="muted" role="status">
+        {MESSAGES[state] ?? (state === "on"
+          ? "Activées sur cet appareil. Par confidentialité, la notification n’affiche jamais le nom du médicament : le détail est dans l’application."
+          : "Recevez un signal sur cet appareil quand un rappel arrive, même si l’application est fermée.")}
+      </p>
+    </div>
+  );
+}
diff -ruN -x __pycache__ -x '*.pyc' -x README-CORRECTIONS.md a/apps/web/src/lib/push.ts b/apps/web/src/lib/push.ts
--- a/apps/web/src/lib/push.ts	1970-01-01 00:00:00.000000000 +0000
+++ b/apps/web/src/lib/push.ts	2026-10-28 02:34:21.445140386 +0000
@@ -0,0 +1,79 @@
+import { API_URL, primeCsrf, readCsrfToken } from "../infrastructure/api/client";
+
+const BASE = `${API_URL}/api/v1/patient/care/push`;
+
+export type PushSupport = "ok" | "ios-install" | "unsupported";
+export type PushResult = "subscribed" | "denied" | "unavailable" | "error";
+
+function isIos(): boolean {
+  return /iPad|iPhone|iPod/.test(navigator.userAgent) || (navigator.platform === "MacIntel" && navigator.maxTouchPoints > 1);
+}
+
+function isStandalone(): boolean {
+  return window.matchMedia("(display-mode: standalone)").matches || (navigator as Navigator & { standalone?: boolean }).standalone === true;
+}
+
+/** Sur iPhone/iPad, le Web Push n’existe que si l’application est ajoutée à l’écran d’accueil (iOS 16.4 minimum). */
+export function pushSupport(): PushSupport {
+  if (typeof window === "undefined") return "unsupported";
+  if (isIos() && !isStandalone()) return "ios-install";
+  if (!("serviceWorker" in navigator) || !("PushManager" in window) || !("Notification" in window)) return "unsupported";
+  return "ok";
+}
+
+/** La clé VAPID est en base64 « URL-safe » : atob() seul la rejette (caractères - et _). */
+export function urlBase64ToUint8Array(value: string): Uint8Array<ArrayBuffer> {
+  const padded = value + "=".repeat((4 - (value.length % 4)) % 4);
+  const raw = atob(padded.replace(/-/g, "+").replace(/_/g, "/"));
+  const bytes = new Uint8Array(new ArrayBuffer(raw.length));
+  for (let i = 0; i < raw.length; i += 1) bytes[i] = raw.charCodeAt(i);
+  return bytes;
+}
+
+async function activeRegistration(): Promise<ServiceWorkerRegistration> {
+  await navigator.serviceWorker.register("/sw.js", { scope: "/" });
+  return navigator.serviceWorker.ready; // pushManager.subscribe exige un service worker actif
+}
+
+export async function currentPushSubscription(): Promise<PushSubscription | null> {
+  const registration = await navigator.serviceWorker.getRegistration();
+  return (await registration?.pushManager.getSubscription()) ?? null;
+}
+
+async function sendToServer(method: "POST" | "DELETE", body: unknown): Promise<boolean> {
+  const csrf = await primeCsrf();
+  if (!csrf.ok) return false;
+  const response = await fetch(`${BASE}/subscriptions/`, {
+    method,
+    headers: { "Content-Type": "application/json", "X-CSRFToken": readCsrfToken() },
+    credentials: "include",
+    body: JSON.stringify(body),
+  });
+  return response.ok;
+}
+
+/** À appeler directement depuis un clic : iOS exige que la demande de permission soit dans le geste de l’utilisateur. */
+export async function subscribeToPush(): Promise<PushResult> {
+  try {
+    const permission = await Notification.requestPermission();
+    if (permission !== "granted") return "denied";
+    const keyResponse = await fetch(`${BASE}/vapid-key/`, { credentials: "include", cache: "no-store" });
+    const key = (await keyResponse.json().catch(() => null))?.data as { enabled?: boolean; public_key?: string } | undefined;
+    if (!keyResponse.ok || !key?.enabled || !key.public_key) return "unavailable";
+    const registration = await activeRegistration();
+    const subscription = (await registration.pushManager.getSubscription())
+      ?? (await registration.pushManager.subscribe({ userVisibleOnly: true, applicationServerKey: urlBase64ToUint8Array(key.public_key) }));
+    if (await sendToServer("POST", { subscription: subscription.toJSON() })) return "subscribed";
+    await subscription.unsubscribe(); // le serveur a refusé : on ne garde pas un abonnement orphelin
+    return "error";
+  } catch {
+    return "error";
+  }
+}
+
+export async function unsubscribeFromPush(): Promise<void> {
+  const subscription = await currentPushSubscription();
+  if (!subscription) return;
+  await sendToServer("DELETE", { endpoint: subscription.endpoint }).catch(() => false);
+  await subscription.unsubscribe();
+}
