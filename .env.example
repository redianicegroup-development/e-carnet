# ============================================================
# E-CARNET — variables d'environnement
# ============================================================
# Ce fichier est un exemple. Ne jamais y mettre de vrai secret.
# Production : saisir les valeurs dans Render/Vercel/Neon, pas dans Git.

# -------------------- API Django --------------------
# LOCAL UNIQUEMENT. Le défaut de l'application est false : ne jamais mettre true en staging/production.
DJANGO_DEBUG=true
DJANGO_SECRET_KEY=dev-only-insecure-key-change-before-deploy
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,testserver
DJANGO_LOG_LEVEL=INFO

# -------------------- Base de données --------------------
# Local Docker uniquement. En Render, utiliser DATABASE_URL fourni par Neon.
POSTGRES_DB=ecarnet
POSTGRES_USER=ecarnet
POSTGRES_PASSWORD=ecarnet-dev-only-change-me
DATABASE_URL=postgres://ecarnet:ecarnet-dev-only-change-me@db:5432/ecarnet

# -------------------- Frontend / sécurité navigateur --------------------
# Variables publiques seulement côté frontend. Ne jamais mettre de secret dans NEXT_PUBLIC_*.
WEB_ORIGIN=http://localhost:3000
CORS_ALLOWED_ORIGINS=http://localhost:3000
CSRF_TRUSTED_ORIGINS=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8000
SESSION_COOKIE_SAMESITE=Lax
CSRF_COOKIE_SAMESITE=Lax

# -------------------- Sessions et QR --------------------
ECARNET_SESSION_AGE_SECONDS=28800
ECARNET_QR_TTL_SECONDS=300
ECARNET_INVITATION_BASE_URL=http://localhost:3000/etablissement/activation

# -------------------- E-mail SMTP --------------------
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.example.test
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
EMAIL_USE_SSL=false
DEFAULT_FROM_EMAIL=no-reply@example.test

# -------------------- OAuth (optionnel en V1) --------------------
# Identifiants consommés uniquement par Django; renseigner dans .env local ou dans Render.
# Ne jamais préfixer ces variables avec NEXT_PUBLIC_.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
APPLE_CLIENT_ID=
APPLE_CLIENT_SECRET=

# -------------------- Production / staging (à renseigner côté hébergeur, jamais dans Git) --------------------
# DJANGO_DEBUG=false
# DJANGO_SECRET_KEY=<chaîne aléatoire de 50+ caractères>
# DJANGO_ALLOWED_HOSTS=api.votre-domaine.ci
# DJANGO_ADMIN_PATH=un-chemin-non-evident/          # défaut : admin/
# DRF_NUM_PROXIES=1                                  # nombre de proxys de confiance devant l'API (sinon IP falsifiable)
# DJANGO_SSL_REDIRECT=true
# DJANGO_HSTS_SECONDS=86400                          # relever progressivement après validation HTTPS
# Cookies : web et API sous le MÊME domaine parent (app. et api.) — voir docs/DEPLOYMENT.md
# SESSION_COOKIE_DOMAIN=.votre-domaine.ci
# CSRF_COOKIE_DOMAIN=.votre-domaine.ci
# CSRF_TRUSTED_ORIGINS=https://app.votre-domaine.ci
# Limitation des tentatives (valeurs par défaut)
# ECARNET_RATE_LOGIN=20/hour
# ECARNET_RATE_LOGIN_EMAIL=8/hour
# ECARNET_RATE_REGISTER=10/hour
# ECARNET_RATE_CODE=10/hour
# ECARNET_RATE_GRANT=60/hour

# -------------------- Front (public) --------------------
# NEXT_PUBLIC_CONTACT_EMAIL=contact@votre-domaine.ci  # utilisé par « Demander l'ouverture » (établissements)
# NEXT_PUBLIC_PILOT_NOTICE=on                          # « off » retire la mention « données fictives » le jour de l'ouverture réelle
