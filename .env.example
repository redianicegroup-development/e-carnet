# ============================================================
# E-CARNET — variables locales (Docker Compose)
# ============================================================
# Ne jamais mettre de vrai secret dans ce fichier.
# Production : voir apps/api/.env.production.example (Render)
# et apps/web/.env.production.example (Vercel). Saisir les valeurs
# dans les tableaux de bord, jamais dans Git.

# -------------------- API Django --------------------
# Local uniquement : ne jamais mettre true en staging/production.
DJANGO_DEBUG=true
DJANGO_SECRET_KEY=dev-only-insecure-key-change-before-deploy
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,testserver
# E-mails superadmins autorisés à ouvrir la surveillance technique.
# Vide en local (DEBUG) = tout superadmin de test peut l'ouvrir. Hors DEBUG, une liste vide ferme l'accès à tous.
ECARNET_OPERATIONS_ADMIN_EMAILS=
ECARNET_RELEASE_VERSION=local
# Étiquette affichée dans la console (vide : « debug » en local, « production » sinon).
ECARNET_ENVIRONMENT=
ECARNET_MONITOR_WEBHOOK_SECRET=local-monitor-secret-change-me

# -------------------- Web Push (optionnel) --------------------
# Sans ces clés, les notifications push sont désactivées.
# Générer avec : python apps/api/scripts/generate-vapid-keys.py
# Ne jamais committer une vraie clé privée ni la préfixer avec NEXT_PUBLIC_.
# ECARNET_VAPID_PUBLIC_KEY=
# ECARNET_VAPID_PRIVATE_KEY=
# ECARNET_VAPID_SUBJECT=mailto:contact@votre-domaine
ECARNET_PUSH_SHOW_DETAILS=false
ECARNET_PUSH_TTL_SECONDS=3600
ECARNET_REMINDER_TIMEZONE=Africa/Abidjan
ECARNET_REMINDER_CATCHUP_MINUTES=10
# ECARNET_RATE_PUSH_SUBSCRIPTION=30/hour

# -------------------- Base de données --------------------
# Local Docker uniquement. Compose construit DATABASE_URL depuis ces trois valeurs.
POSTGRES_DB=ecarnet
POSTGRES_USER=ecarnet
POSTGRES_PASSWORD=ecarnet-dev-only-change-me

# -------------------- Cloudinary (tous les uploads) --------------------
# Ne jamais committer de vraies valeurs : utiliser .env.local ou le gestionnaire de secrets.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_BASE_FOLDER=e-carnet

# -------------------- Frontend / sécurité navigateur --------------------
# Variables publiques seulement côté frontend. Ne jamais mettre de secret dans NEXT_PUBLIC_*.
WEB_ORIGIN=http://localhost:3000
CORS_ALLOWED_ORIGINS=http://localhost:3000
CSRF_TRUSTED_ORIGINS=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8000
SESSION_COOKIE_SAMESITE=Lax
CSRF_COOKIE_SAMESITE=Lax

# -------------------- Sessions et QR --------------------
ECARNET_SESSION_AGE_SECONDS=28800
ECARNET_QR_TTL_SECONDS=300
ECARNET_INVITATION_BASE_URL=http://localhost:3000/etablissement/activation
# Chantier 0 — les fonctions de délégation/adressage restent désactivées par défaut.
ECARNET_TRUSTED_CONTACTS_ENABLED=false
ECARNET_RATE_TRUSTED_CONTACT=10/hour
ECARNET_RATE_TRUSTED_CONTACT_ACCEPT=5/minute
ECARNET_REFERRALS_ENABLED=false
ECARNET_RATE_REFERRAL_CHANGES=30/hour
ECARNET_RATE_REFERRAL_READS=60/hour
# La lecture clinique admin remplace le périmètre actuellement disponible ; peut être coupée rapidement.
ECARNET_ESTABLISHMENT_ADMIN_CLINICAL_READ=true
ECARNET_RATE_ESTABLISHMENT_RECORD_OPEN=30/hour

# -------------------- E-mail (optionnel en local) --------------------
# En production, voir apps/api/.env.production.example.
# ECARNET_CONTACT_NOTIFY_TO=
# ECARNET_RATE_CONTACT=5/hour

# -------------------- OAuth (optionnel) --------------------
# Identifiants consommés uniquement par Django.
# Ne jamais préfixer ces variables avec NEXT_PUBLIC_.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
APPLE_CLIENT_ID=
APPLE_CLIENT_SECRET=

# -------------------- Front (public, optionnel) --------------------
# NEXT_PUBLIC_CONTACT_EMAIL=contact@exemple.ci
